{
	"info": {
		"_postman_id": "e-learn-microservices-collection",
		"name": "E-Learn Microservices Tests",
		"description": "Collection complète pour tester l'architecture microservice (Keycloak, Eureka, Api Gateway, Feign, RabbitMQ)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "0. Sécurité : Obtenir Token (Keycloak)",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "urlencoded",
					"urlencoded": [
						{
							"key": "client_id",
							"value": "elearn-client",
							"type": "text"
						},
						{
							"key": "username",
							"value": "testuser",
							"type": "text"
						},
						{
							"key": "password",
							"value": "password",
							"type": "text"
						},
						{
							"key": "grant_type",
							"value": "password",
							"type": "text"
						}
					]
				},
				"url": {
					"raw": "http://localhost:8081/realms/elearn-realm/protocol/openid-connect/token",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8081",
					"path": [
						"realms",
						"elearn-realm",
						"protocol",
						"openid-connect",
						"token"
					]
				}
			},
			"response": []
		},
		{
			"name": "1. CRUD : Créer un Quiz (Test RabbitMQ)",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{COPIER_COLLER_LE_ACCESS_TOKEN_ICI}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"Quiz sur le Dev Web\",\n    \"description\": \"Test complet sur HTML CSS et JS\",\n    \"questions\": [\"Que signifie HTML ?\", \"Quelle est la différence entre id et class ?\"]\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "http://localhost:9000/quizzes",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "9000",
					"path": [
						"quizzes"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. CRUD : Récupérer tous les Quizzes",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{COPIER_COLLER_LE_ACCESS_TOKEN_ICI}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:9000/quizzes",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "9000",
					"path": [
						"quizzes"
					]
				}
			},
			"response": []
		},
		{
